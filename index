<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anatomy Insights - Student Weblog</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }
        .post-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .post-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .comment-section {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s ease;
        }
        .comment-section.active {
            max-height: 1000px;
        }
        .tag {
            transition: all 0.2s ease;
        }
        .tag:hover {
            transform: scale(1.05);
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .like-btn.liked {
            color: #ef4444;
        }
        .modal {
            display: none;
            position: fixed;
            z-index: 50;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
        }
        .modal-content {
            background-color: #fefefe;
            margin: 10% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 90%;
            max-width: 600px;
            border-radius: 10px;
            animation: modalopen 0.3s;
        }
        @keyframes modalopen {
            from {opacity: 0; transform: translateY(-50px)}
            to {opacity: 1; transform: translateY(0)}
        }
        .mobile-menu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }
        .mobile-menu.active {
            max-height: 500px;
        }
        .filter-btn.active {
            background-color: #3b82f6;
            color: white;
        }
        #postImagePreview {
            display: none;
            max-width: 100%;
            max-height: 200px;
            margin: 10px auto;
            border-radius: 8px;
        }
        /* Image zoom modal styles */
        .image-modal {
            display: none;
            position: fixed;
            z-index: 100;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.9);
        }
        .image-modal-content {
            display: block;
            margin: auto;
            max-width: 90%;
            max-height: 90%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .close-image-modal {
            position: absolute;
            top: 15px;
            right: 35px;
            color: #f1f1f1;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
        }
        .download-btn {
            position: absolute;
            top: 15px;
            right: 100px;
            color: #f1f1f1;
            font-size: 30px;
            cursor: pointer;
        }
        .saved-notification {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: #10B981;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            display: none;
            z-index: 1000;
            animation: fadeInOut 2.5s ease-in-out;
        }
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateY(20px); }
            20% { opacity: 1; transform: translateY(0); }
            80% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(20px); }
        }
    </style>
</head>
<body class="gradient-bg min-h-screen">
    <!-- Header - Simplified version -->
    <header class="bg-white shadow-sm">
        <div class="container mx-auto px-4 py-6">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <i class="fas fa-brain text-3xl text-blue-600"></i>
                    <h1 class="text-2xl font-bold text-gray-800">Anatomy Insights</h1>
                </div>
                <div class="flex items-center space-x-4">
                    <button id="newPostBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                        <i class="fas fa-plus mr-2"></i>New Post
                    </button>
                    <!-- PROFILE PICTURE - CHANGE THIS URL TO YOUR IMAGE -->
                    <div class="w-10 h-10 rounded-full bg-gray-300 overflow-hidden">
                        <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="Profile" class="w-full h-full object-cover">
                        <!-- Replace the above URL with your profile picture URL -->
                        <!-- Example: <img src="images/myprofile.jpg" alt="Profile" class="w-full h-full object-cover"> -->
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
        <!-- Search and Filter -->
        <div class="mb-8 bg-white p-6 rounded-xl shadow">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="relative flex-1">
                    <input type="text" id="searchInput" placeholder="Search anatomy topics..." class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <i class="fas fa-search absolute left-3 top-3.5 text-gray-400"></i>
                </div>
                <div class="flex space-x-2 overflow-x-auto pb-2 md:pb-0">
                    <button class="filter-btn px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-medium whitespace-nowrap active" data-filter="all">All</button>
                    <button class="filter-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm font-medium whitespace-nowrap" data-filter="skeletal">Skeletal</button>
                    <button class="filter-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm font-medium whitespace-nowrap" data-filter="muscular">Muscular</button>
                    <button class="filter-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm font-medium whitespace-nowrap" data-filter="nervous">Nervous</button>
                    <button class="filter-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm font-medium whitespace-nowrap" data-filter="cardiovascular">Cardiovascular</button>
                    <button class="filter-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm font-medium whitespace-nowrap" data-filter="respiratory">Respiratory</button>
                </div>
            </div>
        </div>

        <!-- Posts Grid -->
        <div id="postsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Posts will be added here dynamically -->
            <div class="text-center py-10 text-gray-500 col-span-full" id="noPostsMessage">
                No posts yet. Create your first post!
            </div>
        </div>

        <!-- Load More Button -->
        <div class="mt-10 text-center hidden" id="loadMoreContainer">
            <button id="loadMoreBtn" class="bg-white text-blue-600 border border-blue-600 px-6 py-3 rounded-lg hover:bg-blue-50 transition">
                Load More Posts
            </button>
        </div>
    </main>

    <!-- Image Zoom Modal -->
    <div id="imageModal" class="image-modal">
        <span class="close-image-modal">&times;</span>
        <span class="download-btn" title="Download Image"><i class="fas fa-download"></i></span>
        <img class="image-modal-content" id="zoomedImage">
    </div>

    <!-- Saved Notification -->
    <div id="savedNotification" class="saved-notification">
        <i class="fas fa-check-circle mr-2"></i> Post saved successfully!
    </div>

    <!-- New Post Modal -->
    <div id="newPostModal" class="modal">
        <div class="modal-content">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold">Create New Post</h2>
                <button id="closeModalBtn" class="text-gray-500 hover:text-gray-700">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="newPostForm">
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-medium mb-2" for="postTitle">Title</label>
                    <input type="text" id="postTitle" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter post title" required>
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-medium mb-2" for="postContent">Content</label>
                    <textarea id="postContent" rows="5" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Write your post content here..." required></textarea>
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-medium mb-2">Tags</label>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="tag-selector px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium" data-tag="skeletal">Skeletal</button>
                        <button type="button" class="tag-selector px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium" data-tag="muscular">Muscular</button>
                        <button type="button" class="tag-selector px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium" data-tag="nervous">Nervous</button>
                        <button type="button" class="tag-selector px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium" data-tag="cardiovascular">Cardiovascular</button>
                        <button type="button" class="tag-selector px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium" data-tag="respiratory">Respiratory</button>
                    </div>
                    <input type="hidden" id="selectedTags" value="">
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-medium mb-2" for="postImage">Upload Image</label>
                    <div class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center cursor-pointer" id="imageUploadArea">
                        <i class="fas fa-cloud-upload-alt text-3xl text-gray-400 mb-2"></i>
                        <p class="text-gray-500">Click to upload an image</p>
                        <img id="postImagePreview" class="mt-2">
                        <input type="file" id="postImage" class="hidden" accept="image/*">
                    </div>
                </div>
                <div class="flex justify-end">
                    <button type="button" id="cancelPostBtn" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg mr-2 hover:bg-gray-100">Cancel</button>
                    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Publish Post</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Data storage for posts
        let posts = [];
        let currentFilter = 'all';
        let currentSearchTerm = '';
        let displayedPosts = 0;
        const postsPerLoad = 6;

        // DOM Elements
        const postsGrid = document.getElementById('postsGrid');
        const noPostsMessage = document.getElementById('noPostsMessage');
        const loadMoreContainer = document.getElementById('loadMoreContainer');
        const loadMoreBtn = document.getElementById('loadMoreBtn');
        const searchInput = document.getElementById('searchInput');
        const filterButtons = document.querySelectorAll('.filter-btn');
        const newPostForm = document.getElementById('newPostForm');
        const postTitleInput = document.getElementById('postTitle');
        const postContentInput = document.getElementById('postContent');
        const selectedTagsInput = document.getElementById('selectedTags');
        const postImageInput = document.getElementById('postImage');
        const postImagePreview = document.getElementById('postImagePreview');
        const imageUploadArea = document.getElementById('imageUploadArea');
        const tagSelectors = document.querySelectorAll('.tag-selector');
        const savedNotification = document.getElementById('savedNotification');

        // Image zoom modal elements
        const imageModal = document.getElementById('imageModal');
        const zoomedImage = document.getElementById('zoomedImage');
        const closeImageModal = document.querySelector('.close-image-modal');
        const downloadBtn = document.querySelector('.download-btn');

        // Modal functionality
        const newPostBtn = document.getElementById('newPostBtn');
        const newPostModal = document.getElementById('newPostModal');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const cancelPostBtn = document.getElementById('cancelPostBtn');

        newPostBtn.addEventListener('click', () => {
            newPostModal.style.display = 'block';
        });

        closeModalBtn.addEventListener('click', () => {
            newPostModal.style.display = 'none';
            resetForm();
        });

        cancelPostBtn.addEventListener('click', () => {
            newPostModal.style.display = 'none';
            resetForm();
        });

        window.addEventListener('click', (event) => {
            if (event.target === newPostModal) {
                newPostModal.style.display = 'none';
                resetForm();
            }
            if (event.target === imageModal) {
                imageModal.style.display = 'none';
            }
        });

        // Image upload handling
        imageUploadArea.addEventListener('click', () => {
            postImageInput.click();
        });

        postImageInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    postImagePreview.src = event.target.result;
                    postImagePreview.style.display = 'block';
                    imageUploadArea.querySelector('p').textContent = file.name;
                };
                reader.readAsDataURL(file);
            }
        });

        // Tag selection in modal
        tagSelectors.forEach(tag => {
            tag.addEventListener('click', () => {
                tag.classList.toggle('bg-gray-100');
                tag.classList.toggle('bg-blue-100');
                tag.classList.toggle('text-gray-700');
                tag.classList.toggle('text-blue-700');
                
                // Update selected tags input
                const selectedTags = [];
                document.querySelectorAll('.tag-selector.bg-blue-100').forEach(selectedTag => {
                    selectedTags.push(selectedTag.dataset.tag);
                });
                selectedTagsInput.value = selectedTags.join(',');
            });
        });

        // Form submission
        newPostForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            // Get form data
            const title = postTitleInput.value;
            const content = postContentInput.value;
            const tags = selectedTagsInput.value.split(',');
            const imageFile = postImageInput.files[0];
            
            // Create new post object
            const newPost = {
                id: Date.now(),
                title,
                content,
                tags,
                author: {
                    name: "You",
                    image: "https://randomuser.me/api/portraits/women/44.jpg"
                },
                date: "Just now",
                likes: 0,
                comments: [],
                image: imageFile ? URL.createObjectURL(imageFile) : null
            };
            
            // Add to posts array
            posts.unshift(newPost);
            
            // Reset form and close modal
            resetForm();
            newPostModal.style.display = 'none';
            
            // Show saved notification
            showSavedNotification();
            
            // Refresh posts display
            filterAndDisplayPosts();
        });

        // Show saved notification
        function showSavedNotification() {
            savedNotification.style.display = 'block';
            setTimeout(() => {
                savedNotification.style.display = 'none';
            }, 2500);
        }

        // Filter buttons
        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Update active state
                filterButtons.forEach(btn => btn.classList.remove('active', 'bg-blue-600', 'text-white'));
                button.classList.add('active', 'bg-blue-600', 'text-white');
                
                // Set current filter
                currentFilter = button.dataset.filter;
                
                // Reset display
                displayedPosts = 0;
                
                // Refresh posts display
                filterAndDisplayPosts();
            });
        });

        // Search functionality
        searchInput.addEventListener('input', (e) => {
            currentSearchTerm = e.target.value.toLowerCase();
            
            // Reset display
            displayedPosts = 0;
            
            // Refresh posts display
            filterAndDisplayPosts();
        });

        // Load more posts
        loadMoreBtn.addEventListener('click', () => {
            displayedPosts += postsPerLoad;
            filterAndDisplayPosts();
        });

        // Image zoom modal functionality
        closeImageModal.addEventListener('click', () => {
            imageModal.style.display = 'none';
        });

        downloadBtn.addEventListener('click', () => {
            const imageUrl = zoomedImage.src;
            const link = document.createElement('a');
            link.href = imageUrl;
            link.download = 'anatomy-image-' + Date.now() + '.jpg';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        // Helper function to filter and display posts
        function filterAndDisplayPosts() {
            // Filter posts based on current filter and search term
            let filteredPosts = posts.filter(post => {
                // Filter by category
                const matchesFilter = currentFilter === 'all' || 
                                     post.tags.includes(currentFilter);
                
                // Filter by search term
                const matchesSearch = currentSearchTerm === '' || 
                                     post.title.toLowerCase().includes(currentSearchTerm) || 
                                     post.content.toLowerCase().includes(currentSearchTerm);
                
                return matchesFilter && matchesSearch;
            });
            
            // Clear the grid
            postsGrid.innerHTML = '';
            
            // Show no posts message if no posts match
            if (filteredPosts.length === 0) {
                noPostsMessage.classList.remove('hidden');
                loadMoreContainer.classList.add('hidden');
                return;
            } else {
                noPostsMessage.classList.add('hidden');
            }
            
            // Determine how many posts to show
            const postsToShow = Math.min(displayedPosts + postsPerLoad, filteredPosts.length);
            
            // Add posts to grid
            for (let i = 0; i < postsToShow; i++) {
                const post = filteredPosts[i];
                const postElement = createPostElement(post);
                postsGrid.appendChild(postElement);
            }
            
            // Show/hide load more button
            if (postsToShow < filteredPosts.length) {
                loadMoreContainer.classList.remove('hidden');
            } else {
                loadMoreContainer.classList.add('hidden');
            }
            
            // Attach event listeners to new posts
            attachEventListenersToNewPosts();
        }

        // Helper function to create post element
        function createPostElement(post) {
            const postElement = document.createElement('div');
            postElement.className = 'bg-white rounded-xl shadow overflow-hidden post-card';
            postElement.dataset.id = post.id;
            postElement.dataset.tags = post.tags.join(',');
            
            // Build tags HTML
            const tagsHtml = post.tags.map(tag => {
                const tagColors = {
                    skeletal: 'bg-gray-100 text-gray-700',
                    muscular: 'bg-orange-100 text-orange-700',
                    nervous: 'bg-blue-100 text-blue-700',
                    cardiovascular: 'bg-red-100 text-red-700',
                    respiratory: 'bg-green-100 text-green-700'
                };
                return `<span class="px-2 py-1 ${tagColors[tag] || 'bg-gray-100 text-gray-700'} rounded-full text-xs font-medium tag">${tag.charAt(0).toUpperCase() + tag.slice(1)}</span>`;
            }).join('');
            
            // Build comments HTML
            const commentsHtml = post.comments.map(comment => `
                <div class="flex">
                    <div class="mr-3">
                        <div class="w-8 h-8 rounded-full bg-gray-300 overflow-hidden">
                            <img src="${comment.authorImage}" alt="Commenter" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <div class="flex-1">
                        <div class="bg-gray-50 p-3 rounded-lg">
                            <div class="flex justify-between items-start mb-1">
                                <span class="font-medium text-sm">${comment.author}</span>
                                <span class="text-xs text-gray-500">${comment.date}</span>
                            </div>
                            <p class="text-gray-700 text-sm">${comment.content}</p>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
            
            // Set the HTML content
            postElement.innerHTML = `
                ${post.image ? `
                <div class="h-48 overflow-hidden cursor-pointer view-image-btn">
                    <img src="${post.image}" alt="Post Image" class="w-full h-full object-cover">
                </div>
                ` : ''}
                <div class="p-6">
                    <div class="flex items-center mb-4">
                        <div class="w-8 h-8 rounded-full bg-gray-300 overflow-hidden mr-2">
                            <img src="${post.author.image}" alt="Author" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h3 class="font-medium text-sm">${post.author.name}</h3>
                            <p class="text-gray-500 text-xs">${post.date}</p>
                        </div>
                    </div>
                    <h2 class="text-xl font-bold mb-2">${post.title}</h2>
                    <p class="text-gray-600 text-sm mb-4">${post.content}</p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        ${tagsHtml}
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex space-x-3">
                            <button class="flex items-center text-gray-500 hover:text-blue-600 text-sm like-btn">
                                <i class="far fa-heart mr-1"></i> <span>${post.likes}</span>
                            </button>
                            <button class="flex items-center text-gray-500 hover:text-blue-600 text-sm comment-toggle">
                                <i class="far fa-comment mr-1"></i> <span>${post.comments.length}</span>
                            </button>
                        </div>
                        ${post.image ? `<button class="text-blue-600 text-sm font-medium view-image-btn">View Image</button>` : ''}
                    </div>
                </div>
                <!-- Comment Section -->
                <div class="comment-section border-t border-gray-200">
                    <div class="p-6">
                        <h3 class="font-medium mb-4 text-sm">Comments (${post.comments.length})</h3>
                        <div class="space-y-4 mb-6">
                            ${commentsHtml}
                        </div>
                        <div class="flex items-start">
                            <div class="mr-3">
                                <div class="w-8 h-8 rounded-full bg-gray-300 overflow-hidden">
                                    <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="You" class="w-full h-full object-cover">
                                </div>
                            </div>
                            <div class="flex-1">
                                <textarea class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" rows="2" placeholder="Add a comment..."></textarea>
                                <div class="flex justify-end mt-2">
                                    <button class="add-comment-btn bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition text-sm" data-postid="${post.id}">Post</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            return postElement;
        }

        // Helper function to attach event listeners to new posts
        function attachEventListenersToNewPosts() {
            // Like buttons
            document.querySelectorAll('.like-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const postId = parseInt(this.closest('.post-card').dataset.id);
                    const post = posts.find(p => p.id === postId);
                    const icon = this.querySelector('i');
                    const count = this.querySelector('span');
                    
                    if(this.classList.contains('liked')) {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        post.likes--;
                    } else {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        post.likes++;
                    }
                    
                    count.textContent = post.likes;
                    this.classList.toggle('liked');
                });
            });

            // Comment toggles
            document.querySelectorAll('.comment-toggle').forEach(button => {
                button.addEventListener('click', function() {
                    const postCard = this.closest('.post-card');
                    const commentSection = postCard.querySelector('.comment-section');
                    commentSection.classList.toggle('active');
                    
                    // Close other open comment sections
                    document.querySelectorAll('.comment-section').forEach(section => {
                        if(section !== commentSection && section.classList.contains('active')) {
                            section.classList.remove('active');
                        }
                    });
                });
            });

            // Add comment buttons
            document.querySelectorAll('.add-comment-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const postId = parseInt(this.dataset.postid);
                    const post = posts.find(p => p.id === postId);
                    const textarea = this.closest('.flex-1').querySelector('textarea');
                    const commentContent = textarea.value.trim();
                    
                    if (commentContent) {
                        // Add new comment
                        const newComment = {
                            author: "You",
                            authorImage: "https://randomuser.me/api/portraits/women/44.jpg",
                            date: "Just now",
                            content: commentContent
                        };
                        
                        post.comments.unshift(newComment);
                        
                        // Clear textarea
                        textarea.value = '';
                        
                        // Show saved notification
                        showSavedNotification();
                        
                        // Refresh posts display
                        filterAndDisplayPosts();
                    }
                });
            });

            // View image buttons
            document.querySelectorAll('.view-image-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const imgSrc = this.querySelector('img') ? this.querySelector('img').src : this.closest('.post-card').querySelector('img[alt="Post Image"]').src;
                    zoomedImage.src = imgSrc;
                    imageModal.style.display = 'block';
                });
            });
        }

        // Helper function to reset form
        function resetForm() {
            newPostForm.reset();
            postImagePreview.src = '';
            postImagePreview.style.display = 'none';
            imageUploadArea.querySelector('p').textContent = 'Click to upload an image';
            tagSelectors.forEach(tag => {
                tag.classList.remove('bg-blue-100', 'text-blue-700');
                tag.classList.add('bg-gray-100', 'text-gray-700');
            });
            selectedTagsInput.value = '';
        }

        // Initial setup
        filterAndDisplayPosts();
    </script>
</body>
</html>
